# Telegram Bot Token (from @BotFather)
# Create bot as: @CatIQAirdrop_bot
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=CatIQAirdrop_bot
BOT_DESCRIPTION=Official Multi-chain Airdrop Bot for CatIQ. Join now and get free tokens

# Project / brand
PROJECT_NAME=CatIQ
PROJECT_WEBSITE=https://catiq.xyz

# Channel / Group (bot must be admin to verify membership)
CHANNEL_USERNAME=@catiqofficial
CHANNEL_ID=
GROUP_USERNAME=@CatIQCommunity
GROUP_ID=
# Optional invite link (recommended for Join Group button)
GROUP_INVITE_LINK=

# X / Twitter — set X_POST_URL to the LIVE tweet you want retweeted
X_PROFILE_URL=https://x.com/catiqofficial
X_POST_URL=https://x.com/catiqofficial/status/PUT_TWEET_ID_HERE

# Presale / TGE
PRESALE_URL=https://catiq.xyz
TGE_DATE=TBA

# Rewards
AIRDROP_REWARD=200 $CIQ
REFERRAL_REWARD=300 $CIQ
REQUIRED_REFERRALS=3

# Optional buy tiers (Phase 4: Presale Buyers VIP)
TIER_BRONZE_USD=20
TIER_BRONZE_BONUS=1000
TIER_SILVER_USD=50
TIER_SILVER_BONUS=3000
TIER_GOLD_USD=100
TIER_GOLD_BONUS=7000
TIER_VIP_USD=200
TIER_VIP_BONUS=15000
TIER_BONUS_UNIT=$CIQ

# Admin Telegram user IDs (comma-separated)
ADMIN_IDS=123456789

# Supabase (online payout data — airdrop_claims + buy_proofs)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt_here
